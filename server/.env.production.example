# Set these in the backend hosting environment; this is only a template.
NODE_ENV="production"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET=""
PORT="3000"
FRONTEND_URL="https://your-frontend.example.com"
SCHEDULING_TIMEZONE="Asia/Ho_Chi_Minh"

# Generate JWT_SECRET yourself. Your hosting service may set PORT automatically.
# Use a PostgreSQL URL that supports Prisma migrations (DDL and advisory locks).
